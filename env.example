# Copy to .env (local) or set in your host's environment settings.
PORT=3000
# Passcode for the admin screen (records + employee list). CHANGE THIS.
ADMIN_PASSCODE=2086
# Long random string used to sign the admin cookie. Set it so logins survive restarts.
SESSION_SECRET=change-me-to-a-long-random-string
# Where the SQLite database lives. Must be a persistent disk in production.
DATA_DIR=./data

# --- Optional: append every request to a Google Sheet ---
# 1) Share the sheet with the service account's email (Editor).
# 2) Put the whole service-account JSON on ONE line below, or point to a file.
GOOGLE_SHEET_ID=
SHEET_TAB=制服申請の記録
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
